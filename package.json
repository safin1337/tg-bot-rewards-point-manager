{
  "name": "soulshop-rewards-point-system",
  "version": "2.0.6",
  "private": true,
  "type": "module",
  "description": "Administrator-only Telegram loyalty bot on Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply soulshop-rewards-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply soulshop-rewards-db --remote",
    "telegram:set-commands": "node scripts/set-commands.mjs",
    "telegram:set-webhook": "node scripts/set-webhook.mjs",
    "telegram:delete-webhook": "node scripts/delete-webhook.mjs",
    "telegram:webhook-info": "node scripts/webhook-info.mjs",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
