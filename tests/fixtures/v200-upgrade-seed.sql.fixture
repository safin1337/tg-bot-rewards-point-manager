WITH RECURSIVE n(value) AS (
  SELECT 1
  UNION ALL
  SELECT value + 1 FROM n WHERE value < 41
)
INSERT INTO leaderboard_reset_receipts (
  telegram_update_id, period_type, period_key, generation, status,
  reset_at_utc, administrator_telegram_id
)
SELECT
  1000 + value, 'WEEK', '2026-08-03', 1, 'COMPLETED',
  '2026-08-07T00:00:00.000Z', '123456789'
FROM n;

WITH RECURSIVE n(value) AS (
  SELECT 1
  UNION ALL
  SELECT value + 1 FROM n WHERE value < 41
)
INSERT INTO processed_updates (
  telegram_update_id, update_type, status, processed_at_utc, export_progress
)
SELECT
  2000 + value, 'EXPORT', 'COMPLETED', '2026-08-07T00:00:00.000Z', 'BOTH_SENT'
FROM n;
